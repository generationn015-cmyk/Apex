{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "echo skip",
  "routes": [
    { "src": "/api/alpaca-status", "dest": "/api/alpaca-status.py" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "git": {
    "deploymentEnabled": {
      "master": true,
      "main": false
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- index.html vercel.json api/alpaca-status.py"
}
